{
  "schema_version": "1.0.0",
  "name": "twi_monitor_run",
  "description": "Enqueue one idempotent monitor capture; recurrence remains with Agent OS.",
  "operation": "twi.monitors.run",
  "api": { "method": "POST", "path": "/v1/monitors/{monitor_id}/runs", "idempotency_header": "Idempotency-Key" },
  "authorization": { "required_scope": "twi:monitors:write", "capability": "web.monitor.run", "action": "submit", "resource_pattern": "twi://monitors/{monitor_id}/runs" },
  "governance": { "read_only": false, "consequential": false, "destructive": false, "open_world": true, "idempotency_argument": "idempotency_key" },
  "input_schema": { "type": "object", "additionalProperties": false, "required": ["monitor_id", "idempotency_key"], "properties": { "monitor_id": { "type": "string", "minLength": 1, "maxLength": 64 }, "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 256 } } }
}
