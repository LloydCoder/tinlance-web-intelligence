{
  "schema_version": "1.0.0",
  "name": "twi_monitor_delete",
  "description": "Redact and tombstone a monitor and its stored change summaries; Platform requires exact-intent human approval.",
  "operation": "twi.monitors.delete",
  "api": {
    "method": "DELETE",
    "path": "/v1/monitors/{monitor_id}"
  },
  "authorization": {
    "required_scope": "twi:monitors:delete",
    "capability": "web.monitor.delete",
    "action": "delete",
    "resource_pattern": "twi://monitors/{monitor_id}"
  },
  "governance": {
    "read_only": false,
    "consequential": true,
    "destructive": true,
    "open_world": false,
    "idempotency_argument": "idempotency_key"
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "monitor_id",
      "idempotency_key"
    ],
    "properties": {
      "monitor_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "idempotency_key": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{16,128}$"
      }
    }
  }
}
