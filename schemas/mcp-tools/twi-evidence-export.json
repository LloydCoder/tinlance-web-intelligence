{
  "schema_version": "1.0.0",
  "name": "twi_evidence_export",
  "description": "Export integrity-checked acquisition bytes and provenance for a successful fetch job; does not assert source truth or authority.",
  "operation": "twi.jobs.export_evidence",
  "api": {
    "method": "GET",
    "path": "/v1/jobs/{job_id}/evidence"
  },
  "authorization": {
    "required_scope": "twi:evidence:export",
    "capability": "web.evidence.export",
    "action": "read",
    "resource_pattern": "twi://jobs/{job_id}/evidence"
  },
  "governance": {
    "read_only": true,
    "consequential": false,
    "destructive": false,
    "open_world": false
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["job_id"],
    "properties": {
      "job_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  }
}
