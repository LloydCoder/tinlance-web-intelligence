{
  "name": "@tinlyt/web",
  "version": "0.1.0",
  "private": true,
  "description": "Tinlyt customer-facing web application foundation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "syntax-check": "node scripts/syntax-check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "security": "node scripts/security-check.mjs",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run syntax-check && npm run typecheck && npm run security && npm test && npm run build",
    "release-check": "node scripts/release-check.mjs"
  },
  "type": "module",
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
