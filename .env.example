TWI_ENV=development
TWI_LOG_LEVEL=INFO
TWI_MAX_RESPONSE_BYTES=5000000
TWI_MAX_REDIRECTS=5
TWI_REQUEST_TIMEOUT_SECONDS=15
TWI_ALLOWED_SCHEMES=https,http
TWI_USER_AGENT=TinlanceWebIntelligence/0.1
TWI_DATABASE_PATH=./var/twi.sqlite3
# Full immutable source commit SHA used to bind customer evidence exports to deployed code.
TWI_SOURCE_REVISION=
# Optional in development; required in production with sslmode=verify-full.
TWI_DATABASE_URL=
# Development Compose PostgreSQL password; use URL-safe characters only, never production credentials.
TWI_POSTGRES_PASSWORD=
# Production must use a separate DDL role; Compose falls back to the runtime role only for local development.
TWI_MIGRATION_DATABASE_URL=
# Optional, separate least-privilege role for scheduled artifact retention; must use sslmode=verify-full.
TWI_ARTIFACT_MAINTENANCE_DATABASE_URL=
TWI_ARTIFACT_RETENTION_DAYS=30
TWI_IDENTITY_ISSUER=
TWI_IDENTITY_AUDIENCE=
TWI_IDENTITY_JWKS_URL=
TWI_BRAVE_SEARCH_API_KEY=
TWI_BROWSER_ENABLED=false
TWI_BROWSER_PROXY_URL=
TWI_BROWSER_PROXY_USERNAME=
TWI_BROWSER_PROXY_PASSWORD=
# Required only for the isolated browser-worker/broker deployment; use a unique secret of 32+ characters.
TWI_BROWSER_BROKER_URL=
TWI_BROWSER_BROKER_TOKEN=
# Optional governed source-evidence export to World Intelligence.
TWI_WORLD_INTELLIGENCE_URL=
TWI_WORLD_INTELLIGENCE_TOKEN=
TWI_EGRESS_PROXY_HOST=127.0.0.1
TWI_EGRESS_PROXY_PORT=3128
TWI_EGRESS_PROXY_MAX_CONNECTIONS=100
TWI_EGRESS_PROXY_MAX_TUNNEL_SECONDS=120
TWI_EGRESS_PROXY_MAX_BYTES=25000000
TWI_EGRESS_PROXY_IDLE_TIMEOUT_SECONDS=15
# Optional OTLP/HTTP traces endpoint; require HTTPS outside development/test.
# Use the complete collector URL ending in /v1/traces. Omit to keep tracing non-exporting.
TWI_OTEL_EXPORTER_OTLP_ENDPOINT=

# Tinlyt public early-access endpoint (configure in Vercel; never commit secrets)
EARLY_ACCESS_ENABLED=false
EARLY_ACCESS_TURNSTILE_SITE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY for server-side operations
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EARLY_ACCESS_NOTIFY_EMAIL=
EARLY_ACCESS_ALLOWED_ORIGIN=https://tinlyt.tinlance.com
EARLY_ACCESS_RATE_LIMIT_SALT=
# Set only to the approved notice version after legal/privacy review.
EARLY_ACCESS_PRIVACY_NOTICE_VERSION=
